{
  "name": "hajimi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HAJIMI B 端桌面客户端（Electron + Vue3，对接 L5 Sidecar :8011）",
  "main": "out/main/main.mjs",
  "author": "HAJIMI",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "electron-vite build && electron-builder --win portable nsis",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "build": {
    "appId": "xyz.eicon.hajimi.desktop",
    "productName": "HAJIMI Desktop",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "HAJIMI-Desktop-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "HAJIMI-Desktop-${version}-setup.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  }
}
