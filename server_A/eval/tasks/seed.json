[
  {
    "id": "notepad_type_save",
    "name": "记事本输入文本并保存",
    "category": "editor",
    "instruction": "打开记事本，输入文本 HAJIMI_{seed}_OK，另存为 {EVAL_DIR}/notepad_type_save_{seed}.txt",
    "seeds": ["a", "b", "c"],
    "p0_coverage": ["0.1", "0.2", "0.3", "0.7", "0.8"],
    "setup_ps1": ["New-Item -ItemType Directory -Force -Path $env:EVAL_DIR | Out-Null", "Remove-Item $env:EVAL_DIR/notepad_type_save_*.txt -ErrorAction SilentlyContinue"],
    "cleanup_ps1": ["Get-Process notepad -ErrorAction SilentlyContinue | Stop-Process -Force"],
    "oracle": {
      "all": [
        {"type": "file_exists", "path": "{EVAL_DIR}/notepad_type_save_{seed}.txt"},
        {"type": "file_content_contains", "path": "{EVAL_DIR}/notepad_type_save_{seed}.txt", "needle": "HAJIMI_{seed}_OK"}
      ]
    },
    "max_wall_s": 240,
    "requires": ["notepad"],
    "calibrated": false,
    "notes": "覆盖 done 文件证据(0.7)/type 的 state_changed(0.2)/id×name(0.3)。首次使用需人工两向校准。",
    "source": "handcrafted"
  },
