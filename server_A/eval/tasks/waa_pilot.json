[
  {
    "id": "waa_fe_archive_docx",
    "name": "WAA移植-建归档夹并移入全部docx",
    "category": "file",
    "instruction": "打开资源管理器进入 {EVAL_DIR}/waa_pilot/fe_archive_{seed}/Documents（内有若干 .docx 文件），新建名为 Archive 的文件夹，并把 Documents 里所有 .docx 文件移进 Archive",
    "seeds": [
      "a",
      "b",
      "c"
    ],
    "p0_coverage": [
      "0.1",
      "0.2",
      "0.3",
      "0.7"
    ],
    "setup_ps1": [
      "New-Item -ItemType Directory -Force -Path \"$env:EVAL_DIR/waa_pilot/fe_archive_{seed}/Documents\" | Out-Null",
      "Set-Content -Path \"$env:EVAL_DIR/waa_pilot/fe_archive_{seed}/Documents/Doc01.docx\" -Value \"HAJIMI_WAA_fe_archive_{seed}_DOC01\" -Force",
      "Set-Content -Path \"$env:EVAL_DIR/waa_pilot/fe_archive_{seed}/Documents/Doc02.docx\" -Value \"HAJIMI_WAA_fe_archive_{seed}_DOC02\" -Force",
      "Get-Process explorer -ErrorAction SilentlyContinue | Stop-Process -Force"
    ],
    "cleanup_ps1": [
      "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue \"$env:EVAL_DIR/waa_pilot/fe_archive_{seed}\""
    ],
    "oracle": {
      "all": [
        {
          "type": "file_exists",
          "path": "{EVAL_DIR}/waa_pilot/fe_archive_{seed}/Documents/Archive/Doc01.docx"
        },
        {
          "type": "file_exists",
          "path": "{EVAL_DIR}/waa_pilot/fe_archive_{seed}/Documents/Archive/Doc02.docx"
        },
        {
          "type": "file_not_exists",
          "path": "{EVAL_DIR}/waa_pilot/fe_archive_{seed}/Documents/Doc01.docx"
        },
        {
          "type": "file_not_exists",
          "path": "{EVAL_DIR}/waa_pilot/fe_archive_{seed}/Documents/Doc02.docx"
        }
      ]
    },
    "max_wall_s": 360,
    "requires": [
      "explorer"
    ],
    "expect_status": "success",
    "calibrated": false,
    "source": "waa:0c9dda13-428c-492b-900b-f48562111f93-WOS",
    "notes": "WAA 原 evaluator: exact_match(is_all_docx_in_archive, expected true)（getter 源码=Documents 下所有 docx 均在 Archive 内）。机械翻译=建夹+两文件移入+原位清空四个谓词。waa_upstream_asset_defect: \"0-byte at source; setup switched to local generation\"——上游 winarenafiles 的 Doc01/Doc02.docx 实测均 0 字节空占位（GitHub API size:0 + curl 200/0B 双核），WAA 原任务移的也是空文件；oracle 只认文件名/存在性，故 setup 改 Set-Content 本地生成带 {seed} 标记的占位字节，文件名不变、oracle 四谓词不动。因不再下载，requires 去掉 internet。",
    "waa_orig": {
      "id": "0c9dda13-428c-492b-900b-f48562111f93-WOS",
      "instruction": "Create a new folder named \"Archive\" in the Documents folder and move all .docx files into it.",
      "config": [
        {
          "type": "download",
          "parameters": {
            "files": [
              {
                "url": "https://raw.githubusercontent.com/rogeriobonatti/winarenafiles/main/task_files/file_explorer/0c9dda13-428c-492b-900b-f48562111f93-WOS/config/Doc01.docx",
                "path": "C:\\Users\\Docker\\Documents\\Doc01.docx"
              },
              {
                "url": "https://raw.githubusercontent.com/rogeriobonatti/winarenafiles/main/task_files/file_explorer/0c9dda13-428c-492b-900b-f48562111f93-WOS/config/Doc02.docx",
                "path": "C:\\Users\\Docker\\Documents\\Doc02.docx"
              }
            ]
          }
        },
        {
          "type": "launch",
          "parameters": {
            "command": [
              "explorer",
              "C:\\Users\\Docker\\Documents"
            ]
          }
        },
        {
          "type": "sleep",
          "parameters": {
            "seconds": 0.5
          }
        }
      ],
      "evaluator": {
        "postconfig": [
          {
            "type": "activate_window",
            "parameters": {
              "window_name": "Documents",
              "strict": true
            }
          },
          {
            "type": "sleep",
            "parameters": {
              "seconds": 0.5
            }
          }
        ],
        "func": "exact_match",
        "result": {
          "type": "is_all_docx_in_archive",
          "folder_path": "C:/Users/Docker/Documents"
        },
        "expected": {
          "type": "rule",
          "rules": {
            "expected": "true"
          }
        }
      },
      "postconfig": null,
      "related_apps": [
        "file_explorer"
      ],
      "snapshot": "file_explorer",
      "source": "Microsoft Corporation"
    }
  },
