  {
    "id": "waa_calc_days_to_file",
    "name": "WAA移植-计算器日期差写文件",
    "category": "form",
    "instruction": "打开计算器（用「日期计算」模式），算出 2024年1月3日 到 2024年8月20日 相差多少天，把结果按「X days」格式（如 230 days）保存到 {EVAL_DIR}/waa_pilot/calc_days/numdays.txt",
    "seeds": [
      "default"
    ],
    "p0_coverage": [
      "0.1",
      "0.2",
      "0.3",
      "0.7"
    ],
    "setup_ps1": [
      "New-Item -ItemType Directory -Force -Path \"$env:EVAL_DIR/waa_pilot/calc_days\" | Out-Null",
      "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue \"$env:EVAL_DIR/waa_pilot/calc_days/numdays.txt\"",
      "Get-Process CalculatorApp -ErrorAction SilentlyContinue | Stop-Process -Force",
      "Get-Process Calculator -ErrorAction SilentlyContinue | Stop-Process -Force"
    ],
    "cleanup_ps1": [
      "Get-Process CalculatorApp -ErrorAction SilentlyContinue | Stop-Process -Force",
      "Get-Process Calculator -ErrorAction SilentlyContinue | Stop-Process -Force",
      "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue \"$env:EVAL_DIR/waa_pilot/calc_days\""
    ],
    "oracle": {
      "all": [
        {
          "type": "file_exists",
          "path": "{EVAL_DIR}/waa_pilot/calc_days/numdays.txt"
        },
        {
          "type": "file_content_contains",
          "path": "{EVAL_DIR}/waa_pilot/calc_days/numdays.txt",
          "needle": "230 days"
        }
      ]
    },
    "max_wall_s": 300,
    "requires": [
      "calculator"
    ],
    "expect_status": "success",
    "calibrated": false,
    "source": "waa:28b91a24-5d97-4c2a-891c-dccbd3820c62-WOS-2",
    "notes": "WAA 原 evaluator: exact_match(is_file_saved_desktop numdays.txt contains '230 days')（getter 源码=文件存在且 textcontent in file，故用 file_content_contains 同语义）。seeds=[default]：同 base id 28b91a24 有 WOS/WOS-2/WOS-3 三个变体（不同日期对+不同答案串），WAA 自己拆成三个 JSON——答案随日期变，单 {seed} 宏无法联动，故只移 WOS-2一条，另两条算独立候选任务不混入。",
    "waa_orig": {
      "id": "28b91a24-5d97-4c2a-891c-dccbd3820c62-WOS-2",
      "instruction": "Can you use the calculator app to find how many days are between Jan 3, 2024 and Aug 20 2024? Save the result in a file called 'numdays.txt' on the Desktop (e.g. X days)",
      "config": [
        {
          "type": "launch",
          "parameters": {
            "command": "calc"
          }
        },
        {
          "type": "sleep",
          "parameters": {
            "seconds": 2
          }
        }
      ],
      "evaluator": {
        "func": "exact_match",
        "result": {
          "type": "is_file_saved_desktop",
          "filename": "numdays.txt",
          "textcontent": "230 days"
        },
        "expected": {
          "type": "rule",
          "rules": {
            "expected": "true"
          }
        }
      },
      "postconfig": null,
      "related_apps": [
        "windows_calc"
      ],
      "snapshot": "base_setup",
      "source": "Microsoft Corporation"
    }
  },
