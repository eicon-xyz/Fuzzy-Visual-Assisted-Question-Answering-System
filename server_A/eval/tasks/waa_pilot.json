  {
    "id": "waa_settings_storagesense_weekly",
    "name": "WAA移植-存储感知每周运行",
    "category": "settings",
    "instruction": "打开设置里的「存储感知」（ms-settings:storagesense），开启存储感知，并把「检测磁盘空间的时间间隔」设置为每周",
    "seeds": [
      "default"
    ],
    "p0_coverage": [
      "0.1",
      "0.2",
      "0.5"
    ],
    "setup_ps1": [
      "reg add \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\StorageSense\\Parameters\\StoragePolicy\" /v 01 /t REG_DWORD /d 0 /f",
