      "Invoke-WebRequest -UseBasicParsing -Uri \"https://raw.githubusercontent.com/rogeriobonatti/winarenafiles/main/task_files/notepad/a7d4b6c5-569b-452e-9e1d-ffdb3d431d15-WOS/config/largefile.txt\" -OutFile \"$env:EVAL_DIR/waa_pilot/notepad_count/largefile.txt\"",
