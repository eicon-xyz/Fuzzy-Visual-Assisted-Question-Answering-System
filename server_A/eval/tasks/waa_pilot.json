  {
    "id": "waa_settings_notifications_off",
    "name": "WAA移植-关闭系统通知",
    "category": "settings",
    "instruction": "打开 Windows 设置的「通知」页，把系统通知总开关关闭",
    "seeds": [
      "default"
    ],
    "p0_coverage": [
      "0.1",
      "0.3",
      "0.5"
    ],
    "setup_ps1": [
      "reg add \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\" /v ToastEnabled /t REG_DWORD /d 1 /f",
      "Get-Process SystemSettings -ErrorAction SilentlyContinue | Stop-Process -Force"
    ],
    "cleanup_ps1": [
      "reg delete \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\PushNotifications\" /v ToastEnabled /f"
    ],
    "oracle": {
      "all": [
        {
          "type": "registry_value",
          "hive": "HKEY_CURRENT_USER",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\PushNotifications",
          "name": "ToastEnabled",
          "expect": 0
        }
      ]
    },
    "max_wall_s": 300,
    "requires": [
      "settings"
    ],
    "expect_status": "success",
    "calibrated": false,
    "source": "waa:37e10fc4-b4c5-4b02-a65c-bfae8bc51d3f-wos",
    "notes": "WAA 原 evaluator: exact_match(result=getter system_notifications, expected='True')。getter 源码（settings.py get_system_notifications）= HKCU\\...\\PushNotifications\\ToastEnabled 为 0 时返回 'True'（即已关闭）→ 直接映射 registry_value ToastEnabled=0。setup 先置 1（开启）造基线，cleanup 删除该值恢复系统默认。seeds=[default]：机器级单值状态，无可参数化自由度。",
    "waa_orig": {
      "id": "37e10fc4-b4c5-4b02-a65c-bfae8bc51d3f-wos",
      "instruction": "I need to \"turn off\" notifications for my system in the settings.",
      "config": [],
      "evaluator": {
        "func": "exact_match",
        "result": {
          "type": "system_notifications"
        },
        "expected": {
          "type": "rule",
          "rules": {
            "expected": "True"
          }
        }
      },
      "postconfig": null,
      "related_apps": [
        "settings"
      ],
      "snapshot": "base_setup",
      "source": "https://support.microsoft.com/en-us/windows/change-notification-settings-in-windows-8942c744-6198-fe56-4639-34320cf9444e"
    }
  },
  {
