# 复制此文件为 .env 并填入真实值（L5 Sidecar，无 :9800 纯视觉模式模板）
# 执行层：Windows UIA 绑定（uia_bridge.py）+ Playwright DOM（网页）
# 规划/执行文本 LLM：DeepSeek 官方（deepseek-chat，已验证可用）

LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-llm-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

HAJIMI_DEMO_KEY=hajimi-demo-2026
HAJIMI_HOST=127.0.0.1
HAJIMI_PORT=8011
HAJIMI_DEBUG=true

USE_REAL_LLM=true

# ── OmniParser 已停用（原 :9800 隧道不可用）──
OMNIPARSER_ENABLED=false
OMNIPARSER_URL=
OMNIPARSER_TIMEOUT=10
OMNIPARSER_RETRY=0
OMNIPARSER_LOCAL_URL=
OMNIPARSER_LOCAL_TIMEOUT=10

LLM_SPEED_MODE=fast
ROUTING_MODE=fast
LLM_BASE_URL=

# ── 视觉兜底（可选）──
# L5 在 UIA 取不到控件（画布/游戏类）时启用视觉兜底：
# 需有效视觉 key + VISION_FALLBACK_ENABLED=true
# 例（SiliconFlow）: LLM_BASE_URL=https://api.siliconflow.cn/v1
#                     LLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
#                     LLM_API_KEY=sk-xxxx
VISION_FALLBACK_ENABLED=false
L4_PLANNER_MODEL=deepseek-chat
L4_LOCATOR_MODEL=deepseek-chat
L4_PLANNER_USE_VISION=false
L4_STRICT_LOCATE=false
L4_PIPELINE_ENABLED=true
QWEN_BASE_URL=https://ws-3foqfy9ysbn66ik2.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max
QWEN_API_KEY=
