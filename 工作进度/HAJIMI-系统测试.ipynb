 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# HAJIMI C-A 系统集成测试\n\n> **维护人**：涂浚稷 (20230353) | **更新**：2026-07-06  \n> 按 `Shift+Enter` 逐格执行，验证 C端到A端全部数据回路"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 一、环境 + 端口"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import os, sys, subprocess, time\n",
    "PROJECT = r\"E:\\Fuzzy-Visual-Assisted-Question-Answering-System\"\n",
    "os.chdir(PROJECT)\n",
    "sys.path.insert(0, PROJECT)\n",
    "sys.path.insert(0, os.path.join(PROJECT, \"new_JIMI\", \"HAJIMI_UI\"))\n",
    "\n",
    "# 端口检查\n",
    "for port, name in [(8010,\"A端\"),(5173,\"Web面板\"),(9800,\"OmniParser\")]:\n",
    "    r = subprocess.run(f'cmd //c \"netstat -ano | findstr :{port} | findstr LISTENING\"',\n",
    "                       capture_output=True, text=True, shell=True)\n",
    "    pid = r.stdout.strip().split()[-1] if r.stdout.strip() else \"\"\n",
    "    print(f\"  {'🟢' if pid else '⚪'} :{port} ({name}) {'PID='+pid if pid else '空闲'}\")\n",
    "\n",
    "# 依赖检查\n",
    "for d in ['httpx','fastapi','sqlalchemy','psutil']:\n",
    "    try: __import__(d); print(f\"  ✅ {d}\")\n",
    "    except: print(f\"  ❌ {d} — pip install {d}\")"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 二、启动 A 端"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import httpx, subprocess\n",
    "SERVER = \"http://localhost:8010\"\n",
    "try:\n",
    "    r = httpx.get(f\"{SERVER}/api/demo/health\", timeout=3)\n",
    "    print(f\"  A端已运行: {r.json()}\")\n",
    "except:\n",
    "    print(\"  启动 A 端...\")\n",
    "    subprocess.Popen([\"python\",\"-m\",\"uvicorn\",\"server.main:app\",\n",
    "        \"--host\",\"127.0.0.1\",\"--port\",\"8010\"],\n",
    "        cwd=os.path.join(PROJECT,\"new_JIMI\",\"HAJIMI_UI\"))\n",
    "    for i in range(10):\n",
    "        time.sleep(2)\n",
    "        try:\n",
    "            r = httpx.get(f\"{SERVER}/api/demo/health\", timeout=2)\n",
    "            print(f\"  ✅ 就绪 ({(i+1)*2}s)\")\n",
    "            break\n",
    "        except: pass"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 三、数据回路验证"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import uuid, time, json\n",
    "KEY = \"hajimi-demo-2026\"\n",
    "DH = {\"X-Demo-Key\": KEY, \"Content-Type\": \"application/json\"}\n",
    "AH = {\"X-Admin-Key\": KEY, \"Content-Type\": \"application/json\"}\n",
    "\n",
    "# 审计回路: 发数据 → 写DB → 查询确认\n",
    "tid = f\"nb-{uuid.uuid4().hex[:8]}\"\n",
    "r = httpx.post(f\"{SERVER}/api/audit/report\", headers=DH, json={\n",
    "    \"client_id\":\"notebook\", \"batch\":[{\n",
    "        \"task_id\":tid, \"query\":f\"Jupyter测试:{tid}\",\n",
    "        \"intent_category\":\"operation_guide\", \"route\":\"L3\",\n",
    "        \"total_steps\":3, \"completed_steps\":3, \"result\":\"success\",\n",
    "        \"duration_ms\":5000, \"fingerprint_mismatches\":0,\n",
    "        \"redline_triggered\":False,\n",
    "        \"timestamp\":time.strftime(\"%Y-%m-%dT%H:%M:%S+08:00\")\n",
    "    }]}).json()\n",
    "print(f\"  POST audit/report → received={r.get('received')}\")\n",
    "\n",
    "# 反馈\n",
    "r = httpx.post(f\"{SERVER}/api/audit/feedback\", headers=DH,\n",
    "    json={\"task_id\":tid,\"feedback_type\":\"useful\",\"comment\":\"测试\"}).json()\n",
    "print(f\"  POST audit/feedback → received={r.get('received')}\")\n",
    "\n",
    "# 反向查询确认入库\n",
    "r = httpx.get(f\"{SERVER}/api/admin/stats/overview\", headers=AH).json()\n",
    "print(f\"  GET admin/stats/overview → volume={r.get('today_volume','?')}\")\n",
    "print(f\"\\n  审计回路: C→POST→A→DB→A→GET→C ✅\")"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 配置回路: 写配置 → 拉取验证\n",
    "test_v = str(int(time.time()))[-4:]\n",
    "r = httpx.post(f\"{SERVER}/api/admin/config/deploy\", headers=AH,\n",
    "    json={\"notebook_test\": test_v}).json()\n",
    "print(f\"  POST config/deploy → deployed={r.get('deployed')}\")\n",
    "\n",
    "r = httpx.get(f\"{SERVER}/api/config/pull\", headers=DH).json()\n",
    "cfg = r.get(\"config\",{})\n",
    "print(f\"  GET config/pull → version={cfg.get('version','?')}\")\n",
    "print(f\"\\n  配置回路: C→POST→A→DB→GET→C ✅\")"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 四、Admin 12 端点全检"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "endpoints = [\n",
    "    (\"总览\",\"/api/admin/stats/overview\"), (\"趋势\",\"/api/admin/stats/trend\"),\n",
    "    (\"TOP N\",\"/api/admin/stats/top-tasks\"), (\"红线\",\"/api/admin/stats/redline\"),\n",
    "    (\"反馈\",\"/api/admin/stats/feedback\"), (\"失败\",\"/api/admin/failures/list\"),\n",
    "    (\"配置\",\"/api/admin/config/current\"), (\"拓扑\",\"/api/admin/flow/topology\"),\n",
    "    (\"QPS\",\"/api/admin/flow/metrics\"), (\"版本\",\"/api/admin/flow/versions\"),\n",
    "    (\"健康\",\"/api/admin/monitor/health\"), (\"告警\",\"/api/admin/monitor/alerts\"),\n",
    "]\n",
    "ok, fail = 0, 0\n",
    "for name, path in endpoints:\n",
    "    try:\n",
    "        r = httpx.get(f\"{SERVER}{path}\", headers=AH, timeout=5)\n",
    "        s = \"✅\" if r.status_code == 200 else \"⚠\"\n",
    "        if r.status_code == 200: ok += 1\n",
    "        else: fail += 1\n",
    "        print(f\"  {s} {name} → {r.status_code}\")\n",
    "    except Exception as e:\n",
    "        print(f\"  ❌ {name} → {e}\")\n",
    "        fail += 1\n",
    "print(f\"\\n  {ok} 通过, {fail} 失败\")"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 五、认证验证"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# JWT 签发\n",
    "r = httpx.post(f\"{SERVER}/api/auth/login\",\n",
    "    json={\"username\":\"admin@hajimi.local\",\"password\":\"test123\"}).json()\n",
    "print(f\"  JWT: {r.get('token_type','?')} expires={r.get('expires_in','?')}s\")\n",
    "\n",
    "# 未认证拦截\n",
    "r = httpx.get(f\"{SERVER}/api/admin/stats/overview\")\n",
    "print(f\"  无Key→{r.status_code} (预期401)\")"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 六、端口清理"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import subprocess\n",
    "print(\"⚠ 强制终止 A 端和 Web 面板进程\")\n",
    "c = input(\"输入 yes 确认: \")\n",
    "if c.lower() == \"yes\":\n",
    "    for port in [8010, 5173]:\n",
    "        r = subprocess.run(f'cmd //c \"netstat -ano | findstr :{port} | findstr LISTENING\"',\n",
    "            capture_output=True, text=True, shell=True)\n",
    "        if r.stdout.strip():\n",
    "            pid = r.stdout.strip().split()[-1]\n",
    "            subprocess.run(f\"cmd //c \\\"taskkill /F /PID {pid}\\\"\", shell=True)\n",
    "            print(f\"  🗑 :{port} (PID {pid})\")\n",
    "    print(\"清理完成\")\n",
    "else:\n",
    "    print(\"已取消\")"
   ],
   "execution_count": None, "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["---\n\n**常见问题**：\n\n| 问题 | 解决 |\n|------|------|\n| 端口被占用 | 执行「端口清理」格 |\n| A 端启动慢 | 正常，初始化 7 个 DB 表需 5-8s |\n| 审计回路 0 received | A 端未启动或端口错误 |\n| 配置 deployed=false | 检查 X-Admin-Key header |"]
  }
