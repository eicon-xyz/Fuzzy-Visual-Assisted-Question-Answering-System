  "cards": [
    {
      "dot": "cyan",
      "title": "P0 已接线的闭环",
      "items": [
        "操作前：谓词轮询（可见/启用/稳定/不遮挡），不过则拒发",
        "操作后：属性 diff + expect 轮询（WaitFor），失败自动重观察",
        "done 必带证据；失败首调拦一次；infeasible/ask_user 显式终止",
        "id×name 拦幻觉点击；卡死检测 5/8/12 三级 nudge"
      ]
    },
    {
      "dot": "rose",
      "title": "图上可见的优化缺口",
      "items": [
        "规划一次性静态分解，UI 偏移无人修正 → P1 proactive replan",
        "对话线性增胖、max_tokens 512 → P1 上下文压缩/双账本",
        "感知缺语义 top-k 过滤 → P1；记忆不可回放 → P2 宏库",
        "UIA 盲区（UWP/自绘）→ P2 视觉专家，仅该分支投入模型"
      ]
    },
    {
      "dot": "emerald",
      "title": "安全与可观测",
      "items": [
        "红线双层：B端归一化① + Sidecar 复检②，规则同源 server_A",
        "错误契约 {ok,error_code,hint}，hint 面向 LLM 下一轮自纠",
        "SSE 带 evidence/error_code；评测口径 ≥3 seeds + All-Pass@4"
      ]
    }
  ]
