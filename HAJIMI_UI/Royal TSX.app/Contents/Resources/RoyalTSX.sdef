<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Royal TSX">
	<suite name="Royal TSX Suite" code="rTSX" description="Classes and commands for Royal TSX.">
		<class name="connection" code="RCON" description="A Connection (Computer) object." plural="connections">
			<cocoa class="ScriptableRoyalConnection"/>
			<property name="id" code="ID00" description="The ID of the connection." type="text" access="r">
				<cocoa key="id"/>
			</property>
			<property name="name" code="name" description="The Name of the connection." type="text" access="r">
				<cocoa key="name"/>
			</property>
			<property name="uri" code="URI0" description="The URI (Computer Name/Hostname) of the connection." type="text">
				<cocoa key="uri"/>
			</property>
			<property name="description" code="DESC" description="The Description of the connection." type="text">
				<cocoa key="description"/>
			</property>
			<property name="protocol" code="PROT" description="The connection protocol. Valid values are: RDP, HTTP, SSH, Telnet, VNC, FileTransfer, VMware, WindowsEvents, WindowsServices, WindowsProcesses, TerminalServices, PowerShell, HyperV." type="text" access="r">
				<cocoa key="protocol"/>
			</property>
			<responds-to command="connect">
				<cocoa method="connect"/>
			</responds-to>
		</class>
		<class name="credential" code="RCRE" description="A Credential object." plural="credentials">
			<cocoa class="ScriptableRoyalCredential"/>
			<property name="id" code="ID00" description="The ID of the credential." type="text" access="r">
				<cocoa key="id"/>
			</property>
			<property name="name" code="name" description="The Name of the credential." type="text" access="r">
				<cocoa key="name"/>
			</property>
			<property name="url" code="URL0" description="The URL of the credential." type="text">
				<cocoa key="url"/>
			</property>
			<property name="description" code="DESC" description="The Description of the credential." type="text">
				<cocoa key="description"/>
			</property>
			<property name="username" code="USNA" description="The Username of the credential." type="text">
				<cocoa key="username"/>
			</property>
		</class>
		<class name="application" code="APPC">
			<cocoa class="NSApplication"/>
			<element description="A list of all connections." type="connection" access="r">
				<accessor style="test"/>
				<accessor style="range"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="index"/>
			</element>
			<element description="A list of all credentials." type="credential" access="r">
				<accessor style="test"/>
				<accessor style="range"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="index"/>
			</element>
		</class>
		<command name="open document" code="OPENDOC0" description="Opens a document.">
			<cocoa class="OpenDocumentCommand"/>
			<direct-parameter description="The path of the document." type="text"/>
		</command>
		<command name="save document" code="SAVEDOC0" description="Saves a document. If no parameter is specified the currently selected document will be saved.">
			<cocoa class="SaveDocumentCommand"/>
			<direct-parameter description="The ID or Name of the document." type="text" optional="yes"/>
		</command>
		<command name="close document" code="CLOSEDOC" description="Closes a document. If no parameter is specified the currently selected document will be closed.">
			<cocoa class="CloseDocumentCommand"/>
			<direct-parameter description="The ID or Name of the document." type="text" optional="yes"/>
		</command>
		<command name="connect" code="CONNECT0" description="Connect to a computer. If no parameter is specified the currently selected computer will be connected.">
			<cocoa class="ConnectCommand"/>
			<direct-parameter description="The ID or Name of the computer." type="text" optional="yes"/>
		</command>
		<command name="execute" code="EXECUTE0" description="Execute a command or key sequence task. If no parameter is specified the currently selected command task will be executed.">
			<cocoa class="ExecuteTaskCommand"/>
			<direct-parameter description="The ID or Name of the task." type="text" optional="yes"/>
			<parameter name="in context of" code="ICTX" description="The ID or Name of the context connection. Only applies to command tasks." type="text" optional="yes">
				<cocoa key="context"/>
			</parameter>
		</command>
		<command name="adhoc" code="DOADHOC0" description="Connect Ad Hoc.">
			<cocoa class="AdHocCommand"/>
			<direct-parameter description="The ad hoc connection string (Example: rdp://myhost)." type="text" optional="yes"/>
		</command>
		<command name="disconnect" code="DCONNECT" description="Disconnects from a computer. If no parameter is specified the computer of the currently selected tab will be disconnected.">
			<cocoa class="DisconnectCommand"/>
			<direct-parameter description="The ID or Name of the computer." type="text" optional="yes"/>
		</command>
		<command name="get property value" code="GETPROP0" description="Gets a property value of an object.">
			<cocoa class="GetObjectPropertyCommand"/>
			<parameter name="of key" code="OFKE" description="The key name of the property." type="text">
				<cocoa key="key"/>
			</parameter>
			<parameter name="from id" code="FRID" description="The ID of the object." type="text">
				<cocoa key="id"/>
			</parameter>
			<result description="The value of the requested property and object." type="text"/>
		</command>
		<command name="set property value" code="SETPROP0" description="Sets a property value of an object.">
			<cocoa class="SetObjectPropertyCommand"/>
			<parameter name="of key" code="OFKE" description="The key name of the property." type="text">
				<cocoa key="key"/>
			</parameter>
			<parameter name="of id" code="OFID" description="The ID of the object." type="text">
				<cocoa key="id"/>
			</parameter>
			<parameter name="to" code="TOVA" description="The new value of the property." type="text">
				<cocoa key="value"/>
			</parameter>
			<result description="True if the property value could be set successfully, False if not." type="boolean"/>
		</command>
		<command name="set icon" code="SETICON0" description="Sets a custom icon of an object.">
			<cocoa class="SetIconCommand"/>
			<parameter name="of id" code="OFID" description="The ID of the object." type="text">
				<cocoa key="id"/>
			</parameter>
			<parameter name="to" code="TOPA" description="A path to a valid icon file." type="text">
				<cocoa key="path"/>
			</parameter>
			<result description="True if the custom icon could be set successfully, False if not." type="boolean"/>
		</command>
		<command name="add connection" code="ADDCONN0" description="Adds a new connection to the currently selected folder or document.">
			<cocoa class="AddConnectionCommand"/>
			<parameter name="protocol" code="PROT" description="The connection protocol. Valid values are: RDP, HTTP, SSH, Telnet, VNC, FileTransfer, VMware, WindowsEvents, WindowsServices, WindowsProcesses, TerminalServices, PowerShell, HyperV." type="text">
				<cocoa key="protocol"/>
			</parameter>
			<parameter name="name" code="NAME" description="The Name of the connection." type="text">
				<cocoa key="name"/>
			</parameter>
			<parameter name="uri" code="URI0" description="The URI (Computer Name/Hostname) of the connection." type="text">
				<cocoa key="uri"/>
			</parameter>
			<parameter name="description" code="DESC" description="The Description of the connection." type="text" optional="yes">
				<cocoa key="description"/>
			</parameter>
			<parameter name="physical address" code="MACA" description="The Physical Address of the connection." type="text" optional="yes">
				<cocoa key="physicaladdress"/>
			</parameter>
			<parameter name="credential mode" code="CRED" description="The Credential Mode for the connection. Valid values are: 0 = Do not use any credentials, 1 = Use credentials from parent folder, 2 = Specify username &amp; password, 3 = Use an existing credential, 4 = Specify a credential name." type="integer" optional="yes">
				<cocoa key="credentialmode"/>
			</parameter>
			<parameter name="credential autologon" code="CREA" description="Whether Royal TSX should forward the credentials to the session." type="boolean" optional="yes">
				<cocoa key="credentialautologon"/>
			</parameter>
			<parameter name="credential id" code="CREI" description="The Credential ID for the connection. Must be set if Credential Mode = 3." type="text" optional="yes">
				<cocoa key="credentialid"/>
			</parameter>
			<parameter name="credential name" code="CREN" description="The Credential Name for the connection. Must be set if Credential Mode = 4." type="text" optional="yes">
				<cocoa key="credentialname"/>
			</parameter>
			<parameter name="username" code="USER" description="The Username for the connection. Should be set if Credential Mode = 2." type="text" optional="yes">
				<cocoa key="username"/>
			</parameter>
			<parameter name="password" code="PASS" description="The Password for the connection. Should be set if Credential Mode = 2." type="text" optional="yes">
				<cocoa key="password"/>
			</parameter>
			<result description="The ID of the new connection if creation was successful." type="text"/>
		</command>
		<command name="add folder" code="ADDFOLD0" description="Adds a new folder to the currently selected folder or document.">
			<cocoa class="AddFolderCommand"/>
			<parameter name="name" code="NAME" description="The Name of the folder." type="text">
				<cocoa key="name"/>
			</parameter>
			<parameter name="description" code="DESC" description="The Description of the folder." type="text" optional="yes">
				<cocoa key="description"/>
			</parameter>
			<parameter name="credential mode" code="CRED" description="The Credential Mode for the folder. Valid values are: 0 = Do not use any credentials, 1 = Use credentials from parent folder, 2 = Specify username &amp; password, 3 = Use an existing credential, 4 = Specify a credential name." type="integer" optional="yes">
				<cocoa key="credentialmode"/>
			</parameter>
			<parameter name="credential autologon" code="CREA" description="Whether Royal TSX should forward the credentials to the session." type="boolean" optional="yes">
				<cocoa key="credentialautologon"/>
			</parameter>
			<parameter name="credential id" code="CREI" description="The Credential ID for the folder. Must be set if Credential Mode = 3." type="text" optional="yes">
				<cocoa key="credentialid"/>
			</parameter>
			<parameter name="credential name" code="CREN" description="The Credential Name for the folder. Must be set if Credential Mode = 4." type="text" optional="yes">
				<cocoa key="credentialname"/>
			</parameter>
			<parameter name="username" code="USER" description="The Username for the folder. Should be set if Credential Mode = 2." type="text" optional="yes">
				<cocoa key="username"/>
			</parameter>
			<parameter name="password" code="PASS" description="The Password for the folder. Should be set if Credential Mode = 2." type="text" optional="yes">
				<cocoa key="password"/>
			</parameter>
			<result description="The ID of the new folder if creation was successful." type="text"/>
		</command>
		<command name="add credential" code="ADDCRED0" description="Adds a new credential to the currently selected folder or document.">
			<cocoa class="AddCredentialCommand"/>
			<parameter name="name" code="NAME" description="The Name of the credential." type="text">
				<cocoa key="name"/>
			</parameter>
			<parameter name="description" code="DESC" description="The Description of the credential." type="text" optional="yes">
				<cocoa key="description"/>
			</parameter>
			<parameter name="username" code="USER" description="The Username of the credential." type="text" optional="yes">
				<cocoa key="username"/>
			</parameter>
			<parameter name="password" code="PASS" description="The Password of the credential." type="text" optional="yes">
				<cocoa key="password"/>
			</parameter>
			<result description="The ID of the new credential if creation was successful." type="text"/>
		</command>
		<command name="select object" code="SELECTO0" description="Selects an object in the navigation panel.">
			<cocoa class="SelectObjectCommand"/>
			<direct-parameter description="The ID of the object." type="text"/>
		</command>
		<command name="get object id" code="GETOBJI0" description="Gets the ID of an object.">
			<cocoa class="GetObjectIdCommand"/>
			<parameter name="with name" code="WNAM" description="The name of the object." type="text" optional="yes">
				<cocoa key="name"/>
			</parameter>
			<parameter name="of type" code="OFTY" description="The type of the object. Valid values are: document, folder, connection, credential, task or the actual type name (i.e. RoyalRDSConnection)" type="text" optional="yes">
				<cocoa key="typeName"/>
			</parameter>
			<result description="The ID of the requested object if it could be found." type="text"/>
		</command>
		<command name="get object ids" code="GETOBJI1" description="Gets the IDs of objects.">
			<cocoa class="GetObjectIdsCommand"/>
			<parameter name="with name" code="WNAM" description="The name of the objects." type="text" optional="yes">
				<cocoa key="name"/>
			</parameter>
			<parameter name="of type" code="OFTY" description="The type of the objects." type="text" optional="yes">
				<cocoa key="typeName"/>
			</parameter>
			<result description="The IDs of the requested objects if any could be found.">
				<type type="text" list="yes"/>
			</result>
		</command>
	</suite>
</dictionary>