# 复制此文件为 .env 并填入真实值

# ── LLM API（OpenAI 兼容；daseinai 等中转站示例）──
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5.5
LLM_BASE_URL=https://www.daseinai.xyz/v1
LLM_WIRE_API=responses
LLM_TIMEOUT=60
LLM_ATTEMPT_TIMEOUT=15
LLM_VISION_ATTEMPT_TIMEOUT=45

# ── DeepSeek 官方 fallback（15s 无响应时切换；纯文本无 vision）──
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# ── 服务认证 ──
HAJIMI_DEMO_KEY=hajimi-demo-2026
HAJIMI_HOST=0.0.0.0
HAJIMI_PORT=8010
HAJIMI_DEBUG=true

# ── Demo 开关 ──
USE_REAL_LLM=true
STRICT_FINGERPRINT=false

# ── OmniParser 视觉检测 ──
# GPU API 模式（推荐，B 端默认）：SSH 隧道 :9800 → 远程 cuda
OMNIPARSER_URL=http://127.0.0.1:9800
OMNIPARSER_LOCAL_URL=http://127.0.0.1:9800
OMNIPARSER_TIMEOUT=120
OMNIPARSER_LOCAL_TIMEOUT=120
# GPU API 模式建议 OMNIPARSER_RETRY=0（避免 120s×2 超过 B 端 180s 超时）
OMNIPARSER_RETRY=0
# 本地 CPU 模式改用 :8002，OMNIPARSER_TIMEOUT=360，OMNIPARSER_RETRY=1

# ── SetFit 意图分类模型路径 ──
INTENT_MODEL_PATH=server/services/intent/model

# ── 路由模式（OpenGuider 风格加速）──
# auto | fast (L4 Vision) | balanced (L3 先 plan 后逐步 locate) | precision (L3 OmniParser)
ROUTING_MODE=auto
BROWSER_PLUGIN_ENABLED=true
PER_STEP_LOCATE=true
SCREENSHOT_MAX_SIDE=720
INSPECT_MAX_SIDE=960

# ── L4 Vision 快路径（独立于 L3 / OmniParser）──
# Planner 默认纯文本；Locator 使用 Vision 模型（默认 LLM_MODEL）
L4_PLANNER_MODEL=
# 留空则回退 LLM_MODEL（须支持 Vision）
L4_LOCATOR_MODEL=
L4_PLANNER_USE_VISION=false
L4_PIPELINE_ENABLED=true
L4_STRICT_LOCATE=true
L4_SCREEN_HINTS=true
L4_PLANNER_MAX_TOKENS=900
L4_LOCATOR_MAX_TOKENS=400
L4_PLANNER_TIMEOUT=15
L4_LOCATOR_TIMEOUT=45
# L4 上传截图最长边（像素）；桌面小图标场景建议 1920 以提升 Vision 定位精度
L4_UPLOAD_MAX_SIDE=1280

# ── 多信息辅助定位（Hybrid Assist，默认关闭保回归）──
ASSIST_ENABLED=false
ASSIST_UIA_ENABLED=true
ASSIST_DESKTOP_SHORTCUTS=true
ASSIST_BROWSER_ENABLED=true
ASSIST_WPS_ENABLED=true
ASSIST_HYBRID_MIN_CONFIDENCE=0.72
ASSIST_ROI_VISION_FALLBACK=true
