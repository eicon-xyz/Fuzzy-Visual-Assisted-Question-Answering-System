# 复制此文件为 .env 并填入真实值（无 :9800 纯视觉模式模板）
# 原远程 OmniParser GPU(:9800) 已停用；执行层改用 Windows UIA 绑定 + Playwright。

LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-llm-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# 纯视觉 LLM 模式（不需要 OmniParser）
DETECTOR_BACKEND=vision_llm
ALLOW_DETECTOR_FALLBACK=false
REQUIRE_IMAGE=true

HAJIMI_DEMO_KEY=hajimi-demo-2026
HAJIMI_HOST=127.0.0.1
HAJIMI_PORT=8010
HAJIMI_DEBUG=true

USE_REAL_LLM=true
STRICT_FINGERPRINT=false

# ── OmniParser 已停用（原 :9800 隧道不可用）──
OMNIPARSER_ENABLED=false
OMNIPARSER_URL=
OMNIPARSER_TIMEOUT=10
OMNIPARSER_RETRY=0
OMNIPARSER_RETRY_DELAY=1.0
OMNIPARSER_LOCAL_URL=
OMNIPARSER_LOCAL_TIMEOUT=10

LLM_SPEED_MODE=fast

# L4 路由（fast = 纯视觉规划/定位，不需要 OmniParser）
ROUTING_MODE=fast

# L4 规划/定位模型：文本规划用 deepseek-chat（已验证可用）
L4_PLANNER_MODEL=deepseek-chat
L4_LOCATOR_MODEL=deepseek-chat
L4_PLANNER_USE_VISION=false
L4_STRICT_LOCATE=false
L4_PIPELINE_ENABLED=true

LLM_BASE_URL=

# ── 视觉模型（可选）──
# 需要视觉能力（L4 屏幕定位标注、L5 画布类应用兜底）时，取消注释并填入有效凭据：
# 例1（SiliconFlow）: LLM_BASE_URL=https://api.siliconflow.cn/v1
#                      LLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
#                      LLM_API_KEY=sk-xxxx
# 例2（阿里云百炼）:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                      LLM_MODEL=qwen-vl-max
#                      LLM_API_KEY=sk-xxxx
# 启用后：L4_LOCATOR_MODEL 设为对应视觉模型名；L5 视觉兜底 VISION_FALLBACK_ENABLED=true
QWEN_BASE_URL=https://ws-3foqfy9ysbn66ik2.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max
QWEN_API_KEY=
